# ── 通知設定 ──────────────────────────────────────────────────
# どちらか一方、または両方を設定してください

# Slack Webhook URL
# 取得方法: https://api.slack.com/apps → Your Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# LINE Notify トークン
# 取得方法: https://notify-bot.line.me/my/
LINE_NOTIFY_TOKEN=YOUR_LINE_NOTIFY_TOKEN_HERE

# ── フィルター条件 ────────────────────────────────────────────
# 平均動画視聴数の最小値（デフォルト: 5000）
FILTER_MIN_AVG_VIEWS=5000

# GMV最小値（円, デフォルト: 500000）
FILTER_MIN_GMV=500000

# エンゲージメント率最小値（%, デフォルト: 1.0）
FILTER_MIN_ENGAGEMENT=1.0

# ── 招待設定 ─────────────────────────────────────────────────
# 招待状ごとの送信人数（デフォルト: 50）
INVITE_PER_LETTER=50

# 招待間隔（ミリ秒, デフォルト: 2000）
INVITE_DELAY_MS=2000

# ── スケジュール設定 (cron形式, Asia/Tokyo) ────────────────────
# クリエイター招待: 毎日10:00 AM JST
INVITE_CRON=0 10 * * *

# 商品復旧チェック: 30分ごと
RECOVERY_CRON=*/30 * * * *

# ── ブラウザ設定 ───────────────────────────────────────────────
# ヘッドレスモード (true=バックグラウンド実行, false=ブラウザ表示)
HEADLESS=false

# ── ログ設定 ──────────────────────────────────────────────────
# ログレベル: error / warn / info / debug
LOG_LEVEL=info

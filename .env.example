# ── TikTok アカウント ─────────────────────────────────────────
TIKTOK_EMAIL=your_tiktok_email@example.com
TIKTOK_PASSWORD=your_tiktok_password

# ── Chatwork 通知設定 ─────────────────────────────────────────
# 取得方法: Chatwork → 設定 → API Token
CHATWORK_API_TOKEN=your_chatwork_api_token_here

# 運用アラート送信先ルームID（商品違反・招待完了通知）
# ルームIDはURL: https://www.chatwork.com/#!rid{ROOM_ID} の数字部分
CHATWORK_ROOM_ID=123456789

# レポート送信先ルームID（週次・月次レポート）
# 省略した場合は CHATWORK_ROOM_ID と同じルームに送信
CHATWORK_REPORT_ROOM_ID=123456789

# ── Claude API (レポートAI分析) ────────────────────────────────
# 取得方法: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Sheets API ─────────────────────────────────────────
# スプレッドシートID: URLの /d/{ID}/ の部分
# 例: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# サービスアカウントJSONキーファイルのパス
# 取得方法: Google Cloud Console → IAM → サービスアカウント → キー作成 (JSON)
# ※ スプレッドシートの共有設定でサービスアカウントのメールを編集者として追加してください
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# ── フィルター条件 ────────────────────────────────────────────
FILTER_MIN_AVG_VIEWS=5000
FILTER_MIN_GMV=500000
FILTER_MIN_ENGAGEMENT=1.0

# ── 招待設定 ─────────────────────────────────────────────────
INVITE_PER_LETTER=50
INVITE_DELAY_MS=2000

# ── スケジュール (cron形式, Asia/Tokyo) ───────────────────────
INVITE_CRON=0 10 * * *
RECOVERY_CRON=*/30 * * * *
WEEKLY_REPORT_CRON=0 9 * * 1
MONTHLY_REPORT_CRON=0 9 1 * *

# ── ブラウザ設定 ───────────────────────────────────────────────
HEADLESS=false

# ── ログ設定 ──────────────────────────────────────────────────
LOG_LEVEL=info

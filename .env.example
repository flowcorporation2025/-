# ── Chatwork 通知設定 ─────────────────────────────────────────
# 取得方法: Chatwork → 設定 → API Token
CHATWORK_API_TOKEN=your_chatwork_api_token_here

# 運用アラート送信先ルームID（商品違反・招待完了通知）
# ルームIDはChatworkのURLから確認: https://www.chatwork.com/#!rid{ROOM_ID}
CHATWORK_ROOM_ID=123456789

# レポート送信先ルームID（週次・月次レポート）
# 省略した場合は CHATWORK_ROOM_ID と同じルームに送信
CHATWORK_REPORT_ROOM_ID=123456789

# ── Claude API (レポートAI分析) ────────────────────────────────
# 取得方法: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── フィルター条件 ────────────────────────────────────────────
# 平均動画視聴数の最小値（デフォルト: 5000）
FILTER_MIN_AVG_VIEWS=5000

# GMV最小値（円, デフォルト: 500000）
FILTER_MIN_GMV=500000

# エンゲージメント率最小値（%, デフォルト: 1.0）
FILTER_MIN_ENGAGEMENT=1.0

# ── 招待設定 ─────────────────────────────────────────────────
# 招待状ごとの送信人数（デフォルト: 50）
INVITE_PER_LETTER=50

# 招待間隔（ミリ秒, デフォルト: 2000）
INVITE_DELAY_MS=2000

# ── スケジュール設定 (cron形式, Asia/Tokyo) ────────────────────
# クリエイター招待: 毎日10:00 AM JST
INVITE_CRON=0 10 * * *

# 商品復旧チェック: 30分ごと
RECOVERY_CRON=*/30 * * * *

# 週次レポート: 毎週月曜日 09:00 JST
WEEKLY_REPORT_CRON=0 9 * * 1

# 月次レポート: 毎月1日 09:00 JST
MONTHLY_REPORT_CRON=0 9 1 * *

# ── ブラウザ設定 ───────────────────────────────────────────────
# ヘッドレスモード (true=バックグラウンド実行, false=ブラウザ表示)
HEADLESS=false

# ── ログ設定 ──────────────────────────────────────────────────
# ログレベル: error / warn / info / debug
LOG_LEVEL=info
